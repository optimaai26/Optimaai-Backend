# ── Database ──────────────────────────────────────────────
# One PostgreSQL DB stores users, uploads, ML results, RAG history, BMC
DATABASE_URL=postgresql://optimaai:optimaai123@localhost:5432/optimaai_db

# ── Redis (caching KPIs, recommendations, BMC + Celery broker) ────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT auth ──────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<your_jwt_secret_key>
JWT_EXPIRE_MINUTES=1440

# ── CORS (which frontends can call this API) ──────────────
# Comma-separated, no spaces after commas
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM provider (for RAG + recommendations + BMC) ────────
GEMINI_API_KEY=<your_api_key>

# ── ChromaDB (RAG vector store) ───────────────────────────
CHROMA_DIR=knowledge_base/chroma

#OPENROUTER_API_KEY=<your_api_key>

GROQ_API_KEY=<your_api_key>

RAG_CACHE_TTL=21600

# ── Odoo integration ──────────────────────────────────────
# Where Odoo is reachable.
#   - From inside docker-compose:  http://odoo:8069  (use the service name)
#   - From your host machine:       http://localhost:8069
ODOO_URL=http://localhost:8069

# Odoo database name. Visible in Odoo's login dropdown if you have several,
# or in the URL after creating the DB the first time. Case-sensitive.
ODOO_DB=optimaai_db

# Credentials. Use ODOO_API_KEY in production (Odoo → Preferences →
# Account Security → New API Key) and leave ODOO_PASSWORD empty.
ODOO_USERNAME=<your_user_name>
ODOO_PASSWORD=<your_password>
ODOO_API_KEY=<your_api_key>


# User id (in OptimaAi's `users` table) under which scheduled syncs are
# recorded. Defaults to 1 (the first registered user). Create a dedicated
# service account and put its id here for production.
ODOO_SYNC_USER_ID=1
